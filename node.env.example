# ─── Конфигурация ноды QTR ────────────────────────────────────────────────────
# Скопируй этот файл в .env и заполни нужные значения

# Порт API ноды (по умолчанию 3001)
QTR_PORT=3001

# Порт пула (если пул на том же сервере, по умолчанию 3002)
QTR_POOL_PORT=3002

# ─── Режим работы ─────────────────────────────────────────────────────────────

# Запустить только ноду без майнинга (true/false)
# Установи true если хочешь поддерживать сеть без майнинга
QTR_NO_MINE=false

# Твой публичный IP/домен — нужен чтобы другие ноды могли добавить тебя как пира
# Пример: QTR_PUBLIC_HOST=1.2.3.4
QTR_PUBLIC_HOST=

# ─── Кошелёк майнера (один из вариантов) ──────────────────────────────────────

# Адрес куда будут идти награды за майнинг (начинается с K)
# QTR_MINER_ADDRESS=K...

# Или приватный ключ
# QTR_MINER_PRIVATE_KEY=...

# Или мнемоник (12 слов)
# QTR_MINER_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ─── Ключ пула (только если запускаешь свой пул) ──────────────────────────────
# QTR_POOL_API_KEY=секретный_ключ

# Адрес кошелька пула — на него нода платит награду за найденный пулом блок
# QTR_POOL_ADDRESS=K...
# Приватный ключ того же кошелька — им пул подписывает выплаты воркерам
# QTR_POOL_PRIVATE_KEY=...

# ─── P2P ─────────────────────────────────────────────────────────────────────
# Известные ноды сети через запятую, например:
# QTR_BOOTSTRAP_PEERS=http://1.2.3.4:3001,http://5.6.7.8:3001
QTR_BOOTSTRAP_PEERS=

# ─── Web сервер ───────────────────────────────────────────────────────────────
QTR_WEB_PORT=3000

# Если веб-сервер на отдельном сервере — укажи IP ноды
# QTR_API_HOST=127.0.0.1
